# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# Node / Frontend
# Explicitly ensure frontend source code is tracked
!frontend/
!frontend/**
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend/.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Portable COLMAP install
tools/colmap/

# Job execution runs (ignore all generated job outputs, keep folder structure)
jobs/*
!jobs/.gitkeep

# Data uploads and temporary files
data/uploads/*
!data/uploads/.gitkeep
data/samples/*
!data/samples/.gitkeep
!data/samples/sample_drone.mp4

# Freebuff / temporary logs
.freebuff/
*.log

# Environment & Secret files
.env
.env.local
.env.*.local

# IDE & Editor caches
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
